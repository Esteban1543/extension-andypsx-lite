{
  "manifest_version": 3,
  "name": "AndyPSX Live · Vista Limpia",
  "version": "1.6.0",
  "description": "Reordena andypsx.com/live con sesión iniciada y participa en raffles sin contraseña. CSS + content script aislado.",
  "permissions": ["storage", "tabs", "scripting", "debugger", "alarms"],
  "host_permissions": [
    "*://andypsx.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://andypsx.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/*.js",
        "modules/index.js",
        "modules/*/index.js",
        "modules/*/content.js"
      ],
      "matches": [
        "*://andypsx.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "action": {
    "default_title": "AndyPSX Live · Vista Limpia",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
